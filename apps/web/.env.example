# Kopiér til .env.local (aldrig commit hemmeligheder). I produktion sættes de som secrets i hosting-platformen.
DATABASE_URL=postgres://respin_web_app:CHANGE_ME@localhost:5432/respin?sslmode=require
DB_POOL_MAX=10
# Kanonisk adresse til links i e-mails (https i produktion). Udledes ALDRIG af Host-headeren.
APP_URL=http://localhost:3000
# 'console' skriver mails til serverloggen (kun udvikling – afvises i produktion)
MAIL_TRANSPORT=console
# Tjek mod lækkede adgangskoder (Have I Been Pwned, k-anonymitet)
PWNED_CHECK=on
# Header som den betroede proxy sætter med klientens IP: cf-connecting-ip (Cloudflare) | x-real-ip | x-forwarded-for
TRUSTED_IP_HEADER=x-forwarded-for
TRUSTED_PROXIES=1
# Krypteringsnøgle til TOTP-hemmeligheder (32 byte): openssl rand -base64 32. Opbevar i secret store; skift aldrig uden migrering.
MFA_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CSP_IMG_SRC=
