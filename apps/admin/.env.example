# --- Produktion ---
NODE_ENV=production
ADMIN_ALLOWED_HOSTS=admin.respin.dk
# Kontorets/VPN's faste IP'er (CIDR). Tom liste i produktion = ingen adgang (fail closed).
ADMIN_IP_ALLOWLIST=203.0.113.0/24
# Kun hvis Cloudflare Access allerede håndhæver IP-regler foran appen:
# ADMIN_IP_ALLOWLIST_DISABLED=true
ADMIN_IP_HEADER=cf-connecting-ip
ACCESS_TEAM_DOMAIN=respin.cloudflareaccess.com
ACCESS_AUD=<Application Audience (AUD) tag fra Cloudflare Access>
DATABASE_URL=postgres://respin_admin:CHANGE_ME@host:5432/respin?sslmode=require

# --- Lokal udvikling (afvises i produktion) ---
# ADMIN_DEV_EMAIL=dig@respin.dk
# ADMIN_DEV_ROLE=admin
